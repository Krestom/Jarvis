# --- Core ---
APP_ENV=dev
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- Telegram ---
# Токен бота от @BotFather. Пусто = бот не запускается (только health-режим).
TELEGRAM_BOT_TOKEN=
# Разрешённые Telegram user id — только они получают доступ.
# Формат: через запятую (111,222) или JSON-списком ([111, 222]).
TELEGRAM_ALLOWED_USER_IDS=
# Прокси для Telegram API (нужен при разработке из РФ; на VPS — пусто):
# http://host:port или socks5://host:port
BOT_PROXY=

# Если контейнеры должны ходить в AI/STT через прокси (Docker не видит
# системный прокси Windows) — раскомментируйте и укажите адрес прокси,
# доступный из контейнера (на Docker Desktop — host.docker.internal):
# HTTP_PROXY=http://host.docker.internal:10809
# HTTPS_PROXY=http://host.docker.internal:10809

# --- PostgreSQL (используется compose.yaml) ---
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jarvis
POSTGRES_PORT=5433
# При запуске вне Docker укажите строку подключения явно:
# DATABASE_URL=postgresql+asyncpg://jarvis:change-me@127.0.0.1:5433/jarvis

# --- Зашифрованное хранилище ---
DOCUMENT_STORAGE_PATH=var/documents
# Сгенерировать: python scripts/init_key.py
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KEY_VERSION=1
# Ключи предыдущих версий (только расшифровка, для ротации): 1:<base64>,2:<base64>
DOCUMENT_ENCRYPTION_OLD_KEYS=
# Пусто = используется DOCUMENT_ENCRYPTION_KEY
SECRETS_ENCRYPTION_KEY=

# --- AI-провайдер ---
# none | opencode_go | fake
AI_PROVIDER=none
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/v1
# Только модели протокола OpenAI-совместимого /chat/completions
# (например deepseek-v4.1-flash, glm-5.3-flash, kimi-k2.6)
AI_MODEL=deepseek-v4.1-flash

# --- Improvement backlog (Stage 2) ---
# Гипотезы LLM ниже порога не попадают в backlog
IMPROVEMENT_HYPOTHESIS_MIN_CONFIDENCE=0.75
# Лимит символов для traceback/диагностического контекста в записи
IMPROVEMENT_CONTEXT_MAX_CHARS=4000
# Каталог выгрузок /export_issues
EXPORT_DIR=var/exports

# --- Журнал чата (дневной экспорт диалога) ---
# Текст хранится с маскировкой секретов; можно выключить или укоротить хранение
CHAT_LOG_ENABLED=true
CHAT_LOG_RETENTION_DAYS=30

# --- AI-агент (Stage 3) ---
# Обращение по имени («Джарвис, ...») и продолжение агентского контекста идут
# через агента с инструментами. Выключить: AGENT_ENABLED=false
AGENT_ENABLED=true
# Бюджеты времени (секунды) по профилям
AGENT_ORDINARY_SECONDS=60
AGENT_PLANNING_SECONDS=120
AGENT_RESEARCH_SECONDS=300
# Лимиты шагов оркестрации по профилям
AGENT_ORDINARY_STEPS=12
AGENT_PLANNING_STEPS=20
AGENT_RESEARCH_STEPS=40
# Абсолютные лимиты и защита от циклов
AGENT_MAX_LLM_CALLS=18
AGENT_MAX_REPEAT_TOOL_CALLS=2
AGENT_MAX_TOOL_RETRIES=1
AGENT_QUEUE_WAIT_SECONDS=90
# Web-запросы по профилям
AGENT_WEB_QUERIES_ORDINARY=1
AGENT_WEB_QUERIES_PLANNING=3
AGENT_WEB_QUERIES_RESEARCH=8
# Токены (действуют, только если провайдер отдаёт usage)
AGENT_TOKEN_SOFT_LIMIT=25000
AGENT_TOKEN_HARD_LIMIT=50000
# Маркеры профилей (подстроки в тексте запроса, регистр не важен)
AGENT_PLANNING_MARKERS=спланир,план на,планируем,составь план
AGENT_RESEARCH_MARKERS=исследуй,глубокий поиск,разберись детально,research

# --- Web-поиск для агента (Stage 3) ---
# none | fake | tavily (api.tavily.com; ключ — бесплатный тир 1000 кредитов/мес)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# --- Уведомления (напоминания о сроках, сводки) ---
# Работают, пока бот запущен; адресат — первый из TELEGRAM_ALLOWED_USER_IDS.
NOTIFY_ENABLED=true
NOTIFY_DUE_REMINDERS=true
# Времена сводок (локальные, APP_TIMEZONE): список HH:MM через запятую.
# Сводки в 20:00 и позже — расширенный вечерний формат (закрыто/осталось/завтра).
NOTIFY_DIGEST_TIMES=08:00,09:00,12:00,15:00,18:00,22:00
# Пред-напоминание за N минут до срока (0 — выключить).
NOTIFY_BEFORE_DUE_MINUTES=60
# Как часто проверять сроки (секунды, минимум 30)
NOTIFY_POLL_SECONDS=60

# --- Транскрибация ---
# none | openai_compatible | fake
# openai_compatible работает с любым OpenAI-совместимым /audio/transcriptions
# (OpenAI, Groq, локальный whisper-сервер)
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=ru

# --- MCP ---
MCP_AUTH_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8765
# MCP: read-only доступ из OpenCode (кроме чувствительных заметок — по решению
# владельца они отдаются; секреты — никогда)
MCP_INCLUDE_SENSITIVE=true

# --- HTTP health ---
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
