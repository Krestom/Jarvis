# --- Core ---
APP_ENV=dev
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- Telegram ---
# Токен бота от @BotFather. Пусто = бот не запускается (только health-режим).
TELEGRAM_BOT_TOKEN=
# Разрешённые Telegram user id — только они получают доступ.
# Формат: через запятую (111,222) или JSON-списком ([111, 222]).
TELEGRAM_ALLOWED_USER_IDS=
# Прокси для Telegram API (нужен при разработке из РФ; на VPS — пусто):
# http://host:port или socks5://host:port
BOT_PROXY=

# Если контейнеры должны ходить в AI/STT через прокси (Docker не видит
# системный прокси Windows) — раскомментируйте и укажите адрес прокси,
# доступный из контейнера (на Docker Desktop — host.docker.internal):
# HTTP_PROXY=http://host.docker.internal:10809
# HTTPS_PROXY=http://host.docker.internal:10809

# --- PostgreSQL (используется compose.yaml) ---
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jarvis
POSTGRES_PORT=5433
# При запуске вне Docker укажите строку подключения явно:
# DATABASE_URL=postgresql+asyncpg://jarvis:change-me@127.0.0.1:5433/jarvis

# --- Зашифрованное хранилище ---
DOCUMENT_STORAGE_PATH=var/documents
# Сгенерировать: python scripts/init_key.py
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KEY_VERSION=1
# Ключи предыдущих версий (только расшифровка, для ротации): 1:<base64>,2:<base64>
DOCUMENT_ENCRYPTION_OLD_KEYS=
# Пусто = используется DOCUMENT_ENCRYPTION_KEY
SECRETS_ENCRYPTION_KEY=

# --- AI-провайдер ---
# none | opencode_go | fake
AI_PROVIDER=none
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/v1
# Только модели протокола OpenAI-совместимого /chat/completions
# (например deepseek-v4.1-flash, glm-5.3-flash, kimi-k2.6)
AI_MODEL=deepseek-v4.1-flash

# --- Транскрибация ---
# none | openai_compatible | fake
# openai_compatible работает с любым OpenAI-совместимым /audio/transcriptions
# (OpenAI, Groq, локальный whisper-сервер)
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=ru

# --- MCP ---
MCP_AUTH_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_INCLUDE_SENSITIVE=false

# --- HTTP health ---
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
